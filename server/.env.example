# JARVIS Environment Configuration
# Copy this file to .env and edit as needed

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PREDICT=300
OLLAMA_TEMPERATURE=0.7

# ── Database ──────────────────────────────────────────────────────────────────
# On Windows, use a path like: C:/Users/YourName/jarvis/jarvis.db
DB_PATH=/opt/jarvis/jarvis.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# CHANGE THIS before running in production!
SECRET_TOKEN=jarvis-secret-change-me

# ── Chat ──────────────────────────────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=20

# ── Location ──────────────────────────────────────────────────────────────────
LOCATION_DEFAULT=Chennai, India

# ── TTS Voice ─────────────────────────────────────────────────────────────────
# Options: en-GB-RyanNeural (British male), en-US-AriaNeural (US female), en-US-GuyNeural (US male)
TTS_VOICE=en-GB-RyanNeural
