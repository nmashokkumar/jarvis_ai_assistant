# =============================================================================
# JARVIS Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Bearer token required for all API requests.
# Generate a strong value with: python3 -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — change before exposing JARVIS to any network!
SECRET_TOKEN=jarvis-secret-change-me

# -----------------------------------------------------------------------------
# OLLAMA (Local LLM)
# -----------------------------------------------------------------------------

# Base URL for the Ollama REST API.
# Default assumes Ollama runs on the same machine as JARVIS.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for chat completions.
# Must already be pulled: ollama pull llama3.2:3b
# Other options: llama3.2:1b | mistral:7b | gemma2:9b | phi3:mini
OLLAMA_MODEL=llama3.2:3b

# LLM request timeout in seconds (long for slow hardware)
# OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# Absolute path to the SQLite database file.
DB_PATH=/opt/jarvis/jarvis.db

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Log level: debug | info | warning | error | critical
# LOG_LEVEL=info

# CORS origins (comma-separated list, or * for all)
# CORS_ORIGINS=*

# Max conversation history turns to send to the LLM (keep memory usage bounded)
# MAX_HISTORY_TURNS=20
